{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "konsta-claude-plugins",
  "description": "Konsta's Claude Code plugin marketplace",
  "owner": {
    "name": "Konsta"
  },
  "plugins": [
    {
      "name": "unity-mcp",
      "description": "Unity Editor integration — recompilation, diagnostics, and linting via MCP",
      "version": "1.5.4",
      "author": {
        "name": "Konsta"
      },
      "source": "./plugins/unity-mcp",
      "category": "development"
    },
    {
      "name": "roslyn-ls",
      "description": "LSP using roslyn-language-service.",
      "version": "1.0.0",
      "author": {
        "name": "Konsta"
      },
      "source": "./plugins/roslyn-ls",
      "category": "development",
      "tags": ["csharp"],
      "lspServers": {
        "roslyn-ls": {
          "command": "/Users/konsta/.dotnet/tools/roslyn-language-server",
          "args": ["--stdio", "--autoLoadProjects", "--logLevel", "Information",
                   "--extensionLogDirectory", "/tmp/roslyn-logs"],
          "transport": "stdio",
          "extensionToLanguage": {
            ".cs": "csharp",
            ".csx": "csharp",
            ".cshtml": "csharp"
          },
          "initializationOptions": {},
          "settings": {},
          "startupTimeout": 120000
        }
      }
    }
  ]
}
