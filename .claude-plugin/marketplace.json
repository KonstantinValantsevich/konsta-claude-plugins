{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "konsta-claude-plugins",
  "description": "Konsta's Claude Code plugin marketplace",
  "owner": {
    "name": "Konsta"
  },
  "plugins": [
    {
      "name": "unity-mcp",
      "description": "Unity Editor integration — recompilation, diagnostics, and linting via MCP",
      "version": "1.5.4",
      "author": {
        "name": "Konsta"
      },
      "source": "./plugins/unity-mcp",
      "category": "development"
    },
    {
      "name": "csharp-ls",
      "description": "C# LSP using csharp-ls.",
      "version": "1.1.0",
      "author": {
        "name": "Konsta"
      },
      "source": "./plugins/csharp-ls",
      "category": "development",
      "tags": ["csharp"],
      "lspServers": {
        "csharp-ls": {
          "command": "/Users/konsta/.dotnet/tools/csharp-ls-adapter",
          "transport": "stdio",
          "extensionToLanguage": {
            ".cs": "csharp",
            ".csx": "csharp"
          },
          "env": {
            "DOTNET_ROOT": "/opt/homebrew/opt/dotnet@8/libexec"
          },
          "initializationOptions": {},
          "settings": {},
          "startupTimeout": 120000
        }
      }
    }
  ]
}
