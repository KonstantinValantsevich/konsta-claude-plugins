{
  "name": "unity-mcp",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs && esbuild src/hook/index.ts --bundle --platform=node --format=esm --outfile=dist/hook.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "diff": "^8.0.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^25.3.1",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
